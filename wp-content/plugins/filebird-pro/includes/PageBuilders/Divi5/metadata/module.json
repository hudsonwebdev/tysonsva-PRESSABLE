{
  "name": "filebird/gallery",
  "d4Shortcode": "filebird_divi_gallery",
  "moduleClassName": "filebird_divi_gallery",
  "moduleOrderClassName": "filebird_divi_gallery",
  "title": "FileBird Gallery",
  "titles": "FileBird Galleries",
  "description": "Display images from one or more FileBird folders as a grid or a carousel.",
  "keywords": [
    "filebird",
    "gallery",
    "folder",
    "media",
    "images",
    "carousel"
  ],
  "moduleIcon": "divi/module-gallery",
  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "meta": {}
        },
        "advanced": {
          "html": {},
          "link": {},
          "loop": {},
          "folders": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.folders",
              "label": "Folders",
              "description": "Choose one or more folders to display images from.",
              "category": "basic_option",
              "priority": 10,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "filebird/folder-picker"
              }
            }
          },
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.layout",
              "label": "Layout",
              "description": "Grid wraps images onto several rows; carousel keeps them on one row the visitor can scroll.",
              "category": "layout",
              "priority": 20,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "grid",
                  "options": {
                    "grid": {
                      "label": "Grid"
                    },
                    "carousel": {
                      "label": "Carousel"
                    }
                  }
                }
              }
            }
          },
          "columns": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.columns",
              "label": "Columns",
              "description": "Number of columns to display; in carousel mode this is how many images are visible at once.",
              "category": "layout",
              "priority": 30,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "3",
                  "options": {
                    "1": {
                      "label": "1"
                    },
                    "2": {
                      "label": "2"
                    },
                    "3": {
                      "label": "3"
                    },
                    "4": {
                      "label": "4"
                    },
                    "5": {
                      "label": "5"
                    },
                    "6": {
                      "label": "6"
                    }
                  }
                }
              }
            }
          },
          "crop": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.crop",
              "label": "Crop Images",
              "description": "Trim every image to the same shape so the gallery lines up, instead of following each image's own proportions.",
              "category": "layout",
              "priority": 40,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/toggle",
                "props": {
                  "defaultValue": "off"
                }
              }
            }
          },
          "cropRatio": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.cropRatio",
              "label": "Aspect Ratio",
              "description": "Shape every image is trimmed to. Applies when Crop Images is on.",
              "category": "layout",
              "priority": 50,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "1-1",
                  "options": {
                    "1-1": {
                      "label": "Square (1:1)"
                    },
                    "4-3": {
                      "label": "Landscape (4:3)"
                    },
                    "16-9": {
                      "label": "Widescreen (16:9)"
                    }
                  }
                }
              }
            }
          },
          "lightbox": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.lightbox",
              "label": "Lightbox",
              "description": "Open images in a full screen viewer the visitor can page through.",
              "category": "configuration",
              "priority": 60,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/toggle",
                "props": {
                  "defaultValue": "off"
                }
              }
            }
          },
          "linkTo": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.linkTo",
              "label": "Link To",
              "description": "Link behavior when clicking on an image. Ignored while Lightbox is on, because a link would swallow the click before the viewer sees it.",
              "category": "configuration",
              "priority": 70,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "file",
                  "options": {
                    "none": {
                      "label": "None"
                    },
                    "file": {
                      "label": "Media File"
                    },
                    "post": {
                      "label": "Attachment Page"
                    }
                  }
                }
              }
            }
          },
          "size": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.size",
              "label": "Image Size",
              "description": "Which registered image size to load for each thumbnail.",
              "category": "configuration",
              "priority": 80,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "medium",
                  "options": {
                    "full": {
                      "label": "Full"
                    }
                  }
                }
              }
            }
          },
          "orderby": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.orderby",
              "label": "Order By",
              "description": "Order images by.",
              "category": "configuration",
              "priority": 90,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "date",
                  "options": {
                    "date": {
                      "label": "Date"
                    },
                    "title": {
                      "label": "Title"
                    },
                    "rand": {
                      "label": "Random"
                    }
                  }
                }
              }
            }
          },
          "order": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentGallery",
              "attrName": "module.advanced.order",
              "label": "Order",
              "description": "Sort order.",
              "category": "configuration",
              "priority": 100,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "defaultValue": "DESC",
                  "options": {
                    "DESC": {
                      "label": "Descending"
                    },
                    "ASC": {
                      "label": "Ascending"
                    }
                  }
                }
              }
            }
          }
        },
        "decoration": {
          "animation": {},
          "attributes": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "interactions": {},
          "overflow": {},
          "order": {},
          "position": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "styleProps": {
        "spacing": {
          "important": {
            "desktop": {
              "value": {
                "margin": true
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "label": "Gallery Image",
      "elementType": "element",
      "elementProps": {
        "groupedOptionGroup": true
      },
      "selector": "{{selector}}.et_pb_module .filebird-gallery .filebird-gallery-item img",
      "settings": {
        "decoration": {
          "image": {
            "panel": "design",
            "groupType": "group",
            "groupName": "image",
            "priority": 10,
            "component": {
              "type": "group",
              "name": "divi/image",
              "props": {
                "attrName": "image",
                "groupLabel": "Image",
                "grouped": true,
                "presetGroup": "divi/image"
              }
            }
          }
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentGallery": {
        "panel": "content",
        "groupName": "contentGallery",
        "priority": 10,
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Gallery Settings",
            "initialOpen": true
          }
        }
      }
    }
  }
}
